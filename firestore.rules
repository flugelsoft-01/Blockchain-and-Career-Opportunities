rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document rules
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == 'kalyanjit@gmail.com');
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // User activity logs rules
    match /activity/{activityId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == 'kalyanjit@gmail.com';
      allow write: if false; // Logs are immutable
    }
  }
}
